# ============================================================
# CRM SANHLONGVETCO – Environment Variables Template
# Sao chép file này thành .env.local và điền giá trị thực
# KHÔNG commit .env.local lên Git
# ============================================================

# ────────────────────────────────────────────────────────────
# SUPABASE – Lấy từ: Project Settings → API
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ────────────────────────────────────────────────────────────
# SUPABASE SERVICE ROLE KEY
# Chỉ dùng ở server-side / Edge Functions. KHÔNG expose ra client.
# Lấy từ: Project Settings → API → service_role key
# ────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ────────────────────────────────────────────────────────────
# GOOGLE OAUTH – Lấy từ: Google Cloud Console → Credentials
# Cần cấu hình thêm trong: Supabase Dashboard → Auth → Providers → Google
# ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ────────────────────────────────────────────────────────────
# APP SETTINGS
# ────────────────────────────────────────────────────────────
VITE_APP_NAME="CRM Sanh Long Vetco"
VITE_APP_URL=http://localhost:5173

# URL được phép sau khi xác thực OAuth / đặt lại mật khẩu
# Cần khớp với Redirect URLs trong Supabase Dashboard → Auth → URL Configuration
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ────────────────────────────────────────────────────────────
# SUPABASE LOCAL DEV (khi chạy npx supabase start)
# ────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local-anon-key>
